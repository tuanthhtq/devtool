{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devtool",
  "version": "0.1.0",
  "identifier": "com.pegacorn.devtool",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "devtool",
        "width": 330,
        "height": 390,
        "minWidth": 330,
        "maxWidth": 330,
        "minHeight": 390,
        "resizable": true,
        "maximizable": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
